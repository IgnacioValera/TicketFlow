# Local / Compose: full API base URL (includes /api/v1).
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false

# Render Docker build: set API_ORIGIN to the API public URL (no path).
# The Dockerfile builds VITE_API_BASE_URL as ${API_ORIGIN}/api/v1.
# API_ORIGIN=https://ticketflow-api.onrender.com
