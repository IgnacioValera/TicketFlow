NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Prefer DATABASE_URL in cloud (e.g. Render). If set, DB_HOST/PORT/USER/PASSWORD/DATABASE are ignored.
# DATABASE_URL=postgresql://ticketflow:ticketflow_dev_password@localhost:5432/ticketflow

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ticketflow
DB_PASSWORD=ticketflow_dev_password
DB_DATABASE=ticketflow
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
